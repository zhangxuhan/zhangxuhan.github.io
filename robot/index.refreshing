<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Xuhan Zhang — Real-Time C++ · Simulation & AI Systems</title>
<style>
  :root{
    --bg:#05080f; --bg2:#080d18; --panel:rgba(140,180,220,0.035);
    --ink:#e9eef6; --sub:#8fa2bd; --faint:#5d6e88;
    --cyan:#5fd6df; --blue:#6aa9ff; --cyan-dim:rgba(95,214,223,0.5);
    --violet:#9b8cff; --violet-dim:rgba(155,140,255,0.45);
    --orange:#ff9a52; --orange-dim:rgba(255,154,82,0.4);
    --acc:#9b8cff;
    --line:rgba(120,170,210,0.13); --line2:rgba(120,170,210,0.07);
    --mono:"SFMono-Regular",ui-monospace,"JetBrains Mono","Consolas",monospace;
    --sans:"Inter","Segoe UI",system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  ::selection{background:rgba(155,140,255,0.22)}
  a{color:var(--cyan);text-decoration:none}
  .ai{color:var(--violet)}

  /* ---------- NAV ---------- */
  nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;justify-content:space-between;align-items:center;
    padding:16px 32px;background:rgba(5,8,15,0.55);backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line2);font-size:13px;letter-spacing:.04em}
  nav .brand{font-weight:600;letter-spacing:.06em;color:var(--ink);display:flex;align-items:center;gap:10px}
  nav .brand .dot{width:7px;height:7px;border-radius:50%;background:var(--violet);box-shadow:0 0 8px var(--violet-dim)}
  nav .nav-right{display:flex;align-items:center;gap:22px}
  nav .links{display:flex;gap:18px}
  nav .links a{color:var(--sub);transition:color .25s;white-space:nowrap}
  nav .links a:hover{color:var(--ink)}

  /* ---------- LANGUAGE SWITCH ---------- */
  .lang-switch{display:inline-flex;align-items:center;gap:2px;border:1px solid var(--violet-dim);border-radius:999px;
    padding:4px 6px 4px 11px;background:rgba(155,140,255,0.10);backdrop-filter:blur(6px);flex:none;
    box-shadow:0 0 0 1px rgba(155,140,255,0.08),0 0 16px rgba(155,140,255,0.12)}
  .lang-ico{color:var(--violet);opacity:.9;flex:none;margin-right:5px;width:15px;height:15px}
  .lang-opt{font-family:var(--mono);font-size:12px;letter-spacing:.04em;color:var(--sub);background:none;
    border:none;cursor:pointer;padding:6px 12px;border-radius:999px;transition:all .22s;line-height:1;white-space:nowrap}
  .lang-opt:hover{color:var(--ink)}
  .lang-opt.active{background:var(--violet);color:#0b0820;font-weight:700;box-shadow:0 0 12px var(--violet-dim)}

  @media(max-width:1200px){nav .links{display:none}}
  @media(max-width:520px){nav{padding:12px 16px}.lang-opt{padding:5px 11px}}

  /* ---------- HERO ---------- */
  .hero{position:relative;height:100vh;min-height:620px;overflow:hidden;background:var(--bg);color:var(--ink)}
  .hero-video-wrap{position:absolute;inset:0;z-index:0;display:flex;align-items:center;justify-content:center;
    opacity:0;transform:scale(1.05);animation:heroVideoIn 1.8s cubic-bezier(.16,1,.3,1) forwards;
    -webkit-mask-image:radial-gradient(ellipse at center,#000 38%,rgba(0,0,0,.9) 58%,transparent 88%);
    mask-image:radial-gradient(ellipse at center,#000 38%,rgba(0,0,0,.9) 58%,transparent 88%)}
  .hero-video{width:100%;height:100%;display:block;object-fit:cover;opacity:.62;
    filter:grayscale(1) brightness(.78) contrast(.92)}
  .hero-vignette{position:absolute;inset:0;z-index:1;pointer-events:none;background:
    linear-gradient(to top,#05080f 0%,rgba(5,8,15,.88) 24%,rgba(5,8,15,.16) 58%,transparent 76%),
    linear-gradient(90deg,rgba(5,8,15,.76) 0%,rgba(5,8,15,.2) 42%,transparent 68%),
    radial-gradient(120% 105% at 50% 45%,transparent 48%,rgba(5,8,15,.68) 100%)}
  .hero-grain{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.04;
    background-image:repeating-conic-gradient(#fff 0 0.0006deg,transparent 0.0006deg 0.5deg)}
  .hero-overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;
    padding:0 8vw 8vh;pointer-events:none;z-index:3;opacity:0;transform:translateY(20px);
    animation:heroContentIn 1s .5s cubic-bezier(.16,1,.3,1) forwards}
  .hero-kicker{font-family:var(--mono);font-size:12.5px;letter-spacing:.32em;color:rgba(255,255,255,.62);
    text-transform:uppercase;margin-bottom:18px;opacity:0;animation:rise 1s .2s forwards}
  .hero h1{font-size:clamp(32px,5.6vw,60px);font-weight:600;line-height:1.06;letter-spacing:-.01em;
    max-width:18ch;opacity:0;animation:rise 1s .35s forwards}
  .hero h1 .thin{font-weight:300;color:rgba(255,255,255,.62)}
  .hero .sub{margin-top:22px;font-size:clamp(14px,1.8vw,18px);color:rgba(233,238,246,.72);max-width:52ch;
    opacity:0;animation:rise 1s .55s forwards}
  .hero .sub b{color:var(--ink);font-weight:500}
  .hero-tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px;opacity:0;animation:rise 1s .75s forwards}
  .hero-tags span{font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;color:rgba(233,238,246,.76);
    border:1px solid rgba(255,255,255,.16);border-radius:999px;padding:6px 13px;background:rgba(5,8,15,.56);
    backdrop-filter:blur(8px)}
  @keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  @keyframes heroVideoIn{to{opacity:1;transform:scale(1)}}
  @keyframes heroContentIn{to{opacity:1;transform:none}}

  .scroll-hint{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:4;
    font-family:var(--mono);font-size:10.5px;letter-spacing:.22em;color:rgba(255,255,255,.42);text-transform:uppercase;
    display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:rise 1s 1.1s forwards}
  .scroll-hint .bar{width:1px;height:34px;background:linear-gradient(rgba(255,255,255,.7),transparent);animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{opacity:.3}50%{opacity:1}}

  /* ---------- HERO HUD FRAME ---------- */
  .hero-frame{position:absolute;inset:22px;z-index:2;pointer-events:none}
  .hero-frame .corner{position:absolute;width:26px;height:26px;border:1px solid rgba(255,255,255,.34);opacity:.8}
  .hero-frame .corner.tl{top:0;left:0;border-right:none;border-bottom:none}
  .hero-frame .corner.tr{top:0;right:0;border-left:none;border-bottom:none}
  .hero-frame .corner.bl{bottom:0;left:0;border-right:none;border-top:none}
  .hero-frame .corner.br{bottom:0;right:0;border-left:none;border-top:none}
  .hud{position:absolute;font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;line-height:1.75;
    color:rgba(255,255,255,.5);text-transform:uppercase}
  .hud .k{color:#fff;opacity:.68}
  .hud-tl{top:64px;left:26px}
  .hud-br{bottom:26px;right:26px;text-align:right}
  .hud .live{display:inline-block;width:6px;height:6px;border-radius:50%;background:#fff;
    margin-right:6px;vertical-align:middle;animation:blink 1.6s infinite}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
  .scan{position:absolute;left:10px;right:10px;height:1px;pointer-events:none;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);animation:scan 7.5s ease-in-out infinite}
  @keyframes scan{0%{top:5%}50%{top:95%}100%{top:5%}}
  @media(max-width:767px){
    .hero-video-wrap{inset:10%;width:80%;height:80%}
    .hero-overlay{padding:0 20px 8vh}
    .hero-vignette{background:
      linear-gradient(to top,#05080f 0%,rgba(5,8,15,.92) 34%,transparent 72%),
      radial-gradient(120% 100% at 50% 45%,transparent 46%,rgba(5,8,15,.7) 100%)}
    .hud{display:none}.hero-frame .corner{width:18px;height:18px}
  }
  @media (prefers-reduced-motion:reduce){
    .hero-video-wrap,.hero-overlay{animation:none;opacity:1;transform:none}
  }

  /* ---------- ABOUT STRIP ---------- */
  .about{max-width:1080px;margin:0 auto;padding:120px 32px 30px;text-align:center}
  .about .role{font-family:var(--mono);font-size:12px;letter-spacing:.28em;color:var(--violet);
    text-transform:uppercase;margin-bottom:20px}
  .about h2{font-size:clamp(22px,3.4vw,34px);font-weight:400;line-height:1.4;color:var(--ink)}
  .about h2 b{font-weight:600;color:#fff}
  .about p{margin:24px auto 0;max-width:64ch;color:var(--sub);font-size:15.5px}

  /* ---------- GENERIC SECTION ---------- */
  .sys{max-width:1180px;margin:0 auto;padding:84px 32px;border-top:1px solid var(--line2)}
  .sys .sec-num{font-family:var(--mono);font-size:13px;color:var(--cyan);letter-spacing:.1em}
  .sys .stitle{font-size:clamp(21px,2.6vw,28px);font-weight:500;margin-top:8px;letter-spacing:-.01em;line-height:1.2}
  .sys .ssub{color:var(--sub);font-size:14.5px;margin-top:14px;max-width:64ch;text-wrap:pretty}
  #sdk .ssub + .bullets{margin-top:22px}
  .sys .lead{margin-top:22px;font-size:15px;color:var(--ink);max-width:74ch;line-height:1.7;text-wrap:pretty}
  .nowrap{white-space:nowrap}
  .about p{text-wrap:pretty}
  .sys .lead b{font-weight:600;color:#fff}
  .sys .note{margin-top:30px;border:1px solid var(--line);border-left:3px solid var(--orange);border-radius:10px;
    padding:20px 24px;background:var(--panel)}
  .sys .note h4{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);margin-bottom:12px}
  .sys .note p{font-size:13.5px;color:var(--sub);line-height:1.65;margin-top:10px}
  .sys .note p:first-of-type{margin-top:0}

  .sys.split{display:flex;gap:46px;align-items:stretch}
  .sys.split.media-left{flex-direction:row-reverse}
  .sys.split.media-right{flex-direction:row}
  .sys.split .sec-text,.sys.split .sec-media{flex:1 1 0;min-width:0;display:flex;flex-direction:column}
  .sys.split .sec-media .gallery{flex:1;width:100%;display:grid;gap:14px;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;align-content:stretch}
  .sys.split .sec-media .shot{display:flex;height:100%}
  .sys.split .sec-media .shot img{flex:1;width:100%;height:100%;object-fit:cover;display:block}
  /* 06 single-media: tight image card, no oversized bounding box */
  .sys.split.single-media .sec-media{flex:0 0 auto;align-items:flex-start;max-width:240px}
  .sys.split.single-media .sec-media .gallery{flex:0 0 auto;grid-template-columns:minmax(0,240px);grid-template-rows:auto;align-content:start;justify-content:center}
  .sys.split.single-media .sec-media .gallery.cols-1 .shot{aspect-ratio:auto;height:auto;max-width:240px;margin:0 auto;border-radius:8px}
  .sys.split.single-media .sec-media .gallery.cols-1 .shot img{height:auto}

  .sys.stacked .sec-media{margin-top:44px}

  .bullets{display:grid;grid-template-columns:1fr;gap:11px 30px;list-style:none}
  .sys.split .bullets{grid-template-columns:repeat(2,1fr)}
  .sys.stacked .bullets{grid-template-columns:repeat(3,1fr)}
  .sys.no-media .bullets{grid-template-columns:repeat(2,1fr)}
  .bullets li{position:relative;padding-left:20px;font-size:14px;color:var(--sub);line-height:1.5;min-width:0;overflow-wrap:break-word}
  .bullets li::before{content:"";position:absolute;left:2px;top:9px;width:6px;height:6px;border-radius:50%;
    background:var(--cyan);box-shadow:0 0 6px var(--cyan-dim)}
  .bullets li b{color:var(--ink);font-weight:500}

  .sec-media{margin-top:0}
  .gallery{display:grid;gap:14px}
  .sys.split .gallery{grid-template-columns:repeat(2,1fr)}
  .sys.stacked .gallery{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
  .sys.stacked .gallery.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .sys.stacked .gallery.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .sys.stacked .gallery.cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .shot{position:relative;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#0a0f1a;aspect-ratio:4/3}
  .shot img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.92) contrast(1.02);transition:transform .6s ease,filter .4s}
  .shot:hover img{transform:scale(1.04)}
  .shot .ov{position:absolute;inset:0;background:rgba(5,8,15,0);transition:background .3s;pointer-events:none}
  .shot figcaption{position:absolute;left:0;right:0;bottom:0;padding:10px 12px;font-size:11.5px;color:var(--ink);
    background:linear-gradient(transparent,rgba(4,7,13,0.86));font-family:var(--sans)}
  .shot figcaption b{display:block;color:#fff;font-weight:500;font-size:12px}
  .shot figcaption .cap-no{color:var(--acc,#9b8cff);font-weight:700;font-size:11px;letter-spacing:.03em}
  .shot{cursor:zoom-in}
  .shot .zoom{position:absolute;top:9px;right:9px;width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(8,12,20,.5);backdrop-filter:blur(4px);border:1px solid var(--line);color:#cdd6e6;opacity:0;transform:scale(.85);transition:opacity .25s,transform .25s;pointer-events:none;font-size:14px}
  .shot:hover .zoom{opacity:1;transform:scale(1)}
  .lightbox{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;background:rgba(3,5,10,.92);backdrop-filter:blur(6px);padding:4vh 4vw;cursor:zoom-out}
  .lightbox.open{display:flex}
  .lightbox img{max-width:92vw;max-height:84vh;width:auto;height:auto;object-fit:contain;border-radius:10px;box-shadow:0 24px 80px rgba(0,0,0,.6);background:#0a0f1a}
  .lightbox .lb-cap{position:absolute;left:50%;bottom:3.4vh;transform:translateX(-50%);width:fit-content;max-width:90vw;padding:9px 16px;border-radius:10px;background:rgba(10,14,22,.82);border:1px solid var(--line);color:#e6ecf6;font-size:13px;font-family:var(--sans);text-align:center}
  .lightbox .lb-close{position:absolute;top:18px;right:22px;width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:rgba(10,14,22,.7);border:1px solid var(--line);color:#e6ecf6;font-size:20px;cursor:pointer}

  /* ---------- CALL-CHAIN DIAGRAM ---------- */
  .callchain{margin:26px 0 0;display:flex;flex-direction:column;align-items:stretch;gap:0;max-width:560px}
  .cc-node{border:1px solid var(--violet-dim);background:rgba(155,140,255,0.08);border-radius:10px;
    padding:13px 16px;font-family:var(--mono);font-size:13px;color:var(--ink);text-align:center;letter-spacing:.02em}
  .cc-node b{color:var(--violet);font-weight:700}
  .cc-arrow{text-align:center;color:var(--cyan);font-size:15px;line-height:1.5;opacity:.7}
  .cc-cap{margin-top:14px;font-size:12.5px;color:var(--sub);font-family:var(--mono);letter-spacing:.04em;text-align:center}

  /* ---------- PUBLIC EVIDENCE ---------- */
  .evi-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:26px;max-width:820px}
  .evi-list a{border:1px solid var(--line);border-radius:12px;padding:18px 20px;background:var(--panel);
    display:flex;flex-direction:column;gap:5px;transition:border-color .25s,transform .25s}
  .evi-list a:hover{border-color:var(--violet-dim);transform:translateY(-2px)}
  .evi-list .t{font-size:15px;color:var(--ink);font-weight:500}
  .evi-list .u{font-family:var(--mono);font-size:11.5px;color:var(--cyan);word-break:break-all}
  .evi-list .d{font-size:12.5px;color:var(--sub);margin-top:2px}
  @media(max-width:680px){.evi-list{grid-template-columns:1fr}}

  @media(max-width:860px){
    .sys.split{flex-direction:column;gap:28px}
    .sys.split.media-left{flex-direction:column}
    .sys.split.media-right{flex-direction:column}
    .sys.split .sec-text,.sys.split .sec-media{flex:1 1 auto;width:100%}
    .sys.split .sec-media .gallery{grid-template-columns:repeat(2,1fr);grid-template-rows:auto}
    .sys.split .sec-media .shot{height:auto;aspect-ratio:4/3}
    .sys.stacked .gallery.cols-4,.sys.stacked .gallery.cols-3{grid-template-columns:repeat(2,1fr)}
    .sys.stacked .bullets{grid-template-columns:repeat(2,1fr)}
    .sys.no-media .bullets{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:520px){.gallery,.sys.stacked .gallery.cols-4,.sys.stacked .gallery.cols-3,.sys.stacked .gallery.cols-2,.sys.no-media .bullets{grid-template-columns:1fr}.sys.stacked .bullets{grid-template-columns:1fr}}

  .reveal{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s ease}
  .reveal.in{opacity:1;transform:none}

  /* ---------- INDUSTRIAL / ROBOT EFFECTS (additive) ---------- */
  /* global faint scanline texture */
  body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:40;
    background:repeating-linear-gradient(0deg, rgba(95,214,223,0.022) 0 1px, transparent 1px 3px);
    mix-blend-mode:overlay;opacity:.6}
  /* top HUD scroll progress bar */
  .topbar{position:fixed;top:0;left:0;height:2px;width:100%;z-index:60;transform-origin:left center;
    transform:scaleX(0);background:linear-gradient(90deg,var(--cyan),var(--violet));
    box-shadow:0 0 8px var(--cyan-dim);transition:transform .08s linear}
  /* industrial corner brackets on sections */
  .sys{position:relative}
  .sys .ind-corner{position:absolute;width:14px;height:14px;border:1px solid var(--cyan-dim);opacity:.5;pointer-events:none}
  .sys .ind-corner.tl{top:-1px;left:-1px;border-right:none;border-bottom:none}
  .sys .ind-corner.tr{top:-1px;right:-1px;border-left:none;border-bottom:none}
  .sys .ind-corner.bl{bottom:-1px;left:-1px;border-right:none;border-top:none}
  .sys .ind-corner.br{bottom:-1px;right:-1px;border-left:none;border-top:none}
  /* machined plate around section number */
  .sys .sec-num{position:relative;display:inline-block;padding:5px 12px;margin-bottom:2px;
    border:1px solid var(--cyan-dim);border-radius:3px;background:rgba(95,214,223,0.06);
    box-shadow:inset 0 0 12px rgba(95,214,223,0.08),0 0 10px rgba(95,214,223,0.06);
    color:var(--cyan);font-family:var(--mono);font-size:13px;letter-spacing:.12em}
  .sys .sec-num::before{content:"";position:absolute;left:-6px;top:50%;width:5px;height:1px;
    background:var(--cyan);box-shadow:0 0 6px var(--cyan);transform:translateY(-50%)}
  /* section title hover glitch */
  .sys .stitle{position:relative}
  .sys .stitle:hover{text-shadow:1px 0 rgba(255,90,90,.3),-1px 0 rgba(90,200,255,.3);animation:stglitch .4s steps(2,end) 1}
  @keyframes stglitch{0%{transform:translateX(0)}30%{transform:translateX(-1.5px)}60%{transform:translateX(1.5px)}100%{transform:translateX(0)}}
  /* section reveal scan sweep */
  .sys.reveal::after{content:"";position:absolute;top:0;left:-40%;width:35%;height:100%;pointer-events:none;
    background:linear-gradient(105deg,transparent,rgba(95,214,223,0.14),transparent);transform:skewX(-12deg);opacity:0}
  .sys.reveal.in::after{animation:syssweep 1.1s ease-out forwards}
  @keyframes syssweep{0%{left:-40%;opacity:0}12%{opacity:1}100%{left:130%;opacity:0}}
  /* call-chain animated flow + data bus */
  .cc-arrow{position:relative;animation:ccpulse 1.7s ease-in-out infinite}
  @keyframes ccpulse{0%,100%{opacity:.45;transform:translateY(0)}50%{opacity:1;transform:translateY(2px)}}
  .callchain{position:relative}
  .callchain::before{content:"";position:absolute;left:50%;top:0;width:2px;height:100%;
    background:linear-gradient(180deg,transparent,rgba(95,214,223,0.12),transparent);transform:translateX(-50%);pointer-events:none}
  @media (prefers-reduced-motion: reduce){
    body::after{display:none}
    .topbar{transition:none}
    .sys.reveal::after,.cc-arrow,.sys .stitle:hover{animation:none}
  }

  /* ---------- FOOTER ---------- */
  footer{border-top:1px solid var(--line2);padding:70px 32px 60px;text-align:center;
    background:linear-gradient(180deg,transparent,rgba(8,13,24,0.5))}
  footer .name{font-size:20px;font-weight:500;letter-spacing:.02em}
  footer .tag{font-family:var(--mono);font-size:12px;color:var(--violet);letter-spacing:.18em;margin-top:10px;text-transform:uppercase}
  footer .meta{margin-top:18px;color:var(--faint);font-size:12.5px;font-family:var(--mono);line-height:2}
  footer .disc{margin-top:26px;color:var(--faint);font-size:11px;max-width:62ch;margin-left:auto;margin-right:auto;line-height:1.7}

  /* ---------- BOOT / OPENING ANIMATION ---------- */
  .boot{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;
    background:radial-gradient(120% 100% at 50% 40%,#0b1424 0%,#070b15 50%,#05080f 100%);
    overflow:hidden;transition:transform .9s cubic-bezier(.76,0,.24,1)}
  .boot.gone{transform:translateY(-100%)}
  .boot-scene{display:flex;flex-direction:column;align-items:center;gap:22px}
  .boot-core{width:120px;height:120px;filter:drop-shadow(0 0 18px rgba(95,214,223,.4))}
  .boot-core .bc-ring{fill:none;stroke:rgba(155,140,255,.35);stroke-width:2;stroke-dasharray:6 10;
    transform-origin:60px 60px;animation:bcspin 6s linear infinite}
  .boot-core .bc-ring2{fill:none;stroke:rgba(95,214,223,.5);stroke-width:2;stroke-dasharray:3 8;
    transform-origin:60px 60px;animation:bcspin 4s linear infinite reverse}
  .boot-core .bc-eye{fill:rgba(95,214,223,.9);filter:drop-shadow(0 0 10px rgba(95,214,223,.8));
    transform-origin:60px 60px;animation:bcbreathe 1.5s ease-in-out infinite}
  @keyframes bcspin{to{transform:rotate(360deg)}}
  @keyframes bcbreathe{0%,100%{opacity:.55;transform:scale(.86)}50%{opacity:1;transform:scale(1.06)}}
  .boot-log{font-family:var(--mono);font-size:13px;line-height:1.95;color:var(--sub);text-align:center;letter-spacing:.04em}
  .boot-log div{opacity:0;animation:bootIn .35s ease forwards}
  .boot-log div:nth-child(1){animation-delay:.04s}
  .boot-log div:nth-child(2){animation-delay:.18s}
  .boot-log div:nth-child(3){animation-delay:.32s}
  .boot-log div:nth-child(4){animation-delay:.46s;color:var(--cyan);font-weight:600}
  .boot-log .ok{color:var(--violet)}
  .boot-log .on{color:var(--cyan)}
  @keyframes bootIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .boot-bar{width:240px;height:3px;border-radius:3px;background:rgba(120,170,210,.12);overflow:hidden}
  .boot-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--violet),var(--cyan));
    box-shadow:0 0 12px var(--cyan);animation:fill .45s ease .05s forwards}
  @keyframes fill{to{width:100%}}
  .boot-enter{font-family:var(--mono);font-size:11.5px;letter-spacing:.22em;color:var(--faint);
    background:none;border:1px solid var(--line);padding:7px 16px;border-radius:4px;cursor:pointer;
    opacity:0;animation:bootIn .4s ease .55s forwards;transition:color .2s,border-color .2s}
  .boot-enter:hover{color:var(--cyan);border-color:var(--cyan-dim)}
  @media (prefers-reduced-motion: reduce){
    .boot{display:none}
    .boot-core .bc-ring,.boot-core .bc-ring2,.boot-core .bc-eye{animation:none}
    .boot-log div,.boot-bar i,.boot-enter{animation:none;opacity:1}
  }
</style>
</head>
