(function(){
  const SVG_NS = 'http://www.w3.org/2000/svg';
  function applyLang(lang){
    document.documentElement.setAttribute('lang', lang);
    document.querySelectorAll('[data-i18n]').forEach(el=>{
      const k = el.getAttribute('data-i18n');
      const val = I18N[lang] && I18N[lang][k];
      if(val === undefined) return;
      if(el.namespaceURI === SVG_NS){ el.textContent = val; }
      else { el.innerHTML = val; }
    });
    document.querySelectorAll('.lang-opt').forEach(b=>{
      const on = b.dataset.lang === lang;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    try{ localStorage.setItem('lang', lang); }catch(e){}
  }
  document.querySelectorAll('.lang-opt').forEach(b=>{
    b.addEventListener('click', ()=> applyLang(b.dataset.lang));
  });
  let saved = null;
  try{ saved = localStorage.getItem('lang'); }catch(e){}
  if(!saved){ saved = 'en'; }
  applyLang(saved);
})();

/* ---- Lightbox: click an image to enlarge ---- */
(function(){
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lbImg');
  const lbCap = document.getElementById('lbCap');
  const lbClose = document.getElementById('lbClose');
  if(!lb) return;
  function open(src, cap){
    lbImg.src = src;
    lbCap.textContent = cap || '';
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function close(){
    lb.classList.remove('open');
    lbImg.src = '';
    lbCap.textContent = '';
    document.body.style.overflow = '';
  }
  document.querySelectorAll('.shot').forEach(shot=>{
    const z = document.createElement('div');
    z.className = 'zoom';
    z.innerHTML = '&#10799;';
    shot.appendChild(z);
    const im = shot.querySelector('img');
    if(!im) return;
    im.style.cursor = 'zoom-in';
    im.addEventListener('click', e=>{
      e.stopPropagation();
      const cap = shot.querySelector('figcaption') ? shot.querySelector('figcaption').textContent.trim() : '';
      open(im.currentSrc || im.src, cap);
    });
  });
  lb.addEventListener('click', close);
  lbClose.addEventListener('click', e=>{ e.stopPropagation(); close(); });
  document.addEventListener('keydown', e=>{ if(e.key === 'Escape' && lb.classList.contains('open')) close(); });
})();

/* ============ industrial: top progress + section brackets ============ */
(function(){
  var bar=document.getElementById('topbar');
  if(bar){
    var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function upd(){
      var d=document.documentElement, max=d.scrollHeight-d.clientHeight;
      var p=max>0?Math.min(1,Math.max(0,d.scrollTop/max)):0;
      if(reduce) bar.style.width=(p*100)+'%'; else bar.style.transform='scaleX('+p+')';
    }
    window.addEventListener('scroll',upd,{passive:true});
    window.addEventListener('resize',upd); upd();
  }
  document.querySelectorAll('.sys').forEach(function(s){
    ['tl','tr','bl','br'].forEach(function(c){
      var sp=document.createElement('span'); sp.className='ind-corner '+c; s.appendChild(sp);
    });
  });
})();

/* ============ BOOT / OPENING ANIMATION ============ */
(function(){
  var boot=document.getElementById('boot');
  if(!boot) return;
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var done=false;
  function finish(){
    if(done) return; done=true;
    document.body.style.overflow='';
    if(boot.parentNode) boot.parentNode.removeChild(boot);
  }
  function endBoot(){
    if(reduce){ finish(); return; }
    boot.classList.add('gone');
    boot.addEventListener('transitionend', function(e){ if(e.propertyName==='transform') finish(); });
    setTimeout(finish, 1100);
  }
  var enter=document.getElementById('bootEnter');
  if(enter) enter.addEventListener('click', endBoot);
  if(reduce){ finish(); return; }
  document.body.style.overflow='hidden';
  setTimeout(endBoot, 1220);
})();
</script>
</body>
</html>
