<script>
/* ============ HERO — robot motif, no radar ring ============ */
(function(){
  const cv=document.getElementById('heroCanvas');
  if(!cv) return;
  const ctx=cv.getContext('2d');
  let W,H,pts=[];
  function resize(){
    const dpr=Math.min(window.devicePixelRatio||1,2);
    W=cv.clientWidth; H=cv.clientHeight;
    cv.width=W*dpr; cv.height=H*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);
    pts=[];
    for(let i=0;i<70;i++){
      pts.push({a:Math.random()*6.28, r:0.30+Math.random()*0.55,
                sp:0.12+Math.random()*0.4, ph:Math.random()*6.28});
    }
  }
  window.addEventListener('resize',resize); resize();
  const elMode=document.getElementById('hudMode');

  /* cursor-driven look direction (robot eyes track pointer) */
  let mNX=0, mNY=0;
  window.addEventListener('mousemove', function(e){
    const r=cv.getBoundingClientRect();
    if(!r.width) return;
    mNX=Math.max(-1,Math.min(1,(e.clientX-(r.left+r.width/2))/(r.width/2)));
    mNY=Math.max(-1,Math.min(1,(e.clientY-(r.top+r.height/2))/(r.height/2)));
  });

  function rr(x,y,w,h,r){
    ctx.beginPath();
    if(ctx.roundRect){ ctx.roundRect(x,y,w,h,r); }
    else{
      ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r);
      ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath();
    }
  }

  function draw(now){
    const t=now/1000;
    ctx.fillStyle='#05080f'; ctx.fillRect(0,0,W,H);

    const hy=H*0.72;
    const cx=W*0.5, cy=H*0.46;
    const s=Math.min(W,H)/760;            // robot scale

    /* perspective grid floor */
    ctx.strokeStyle='rgba(120,170,210,0.06)'; ctx.lineWidth=1;
    for(let i=-12;i<=12;i++){
      const x=W/2+i*(W*0.045);
      ctx.beginPath(); ctx.moveTo(W/2,hy); ctx.lineTo(x+i*(W*0.10),H); ctx.stroke();
    }
    for(let i=1;i<=8;i++){
      const d=i/8; const y=hy+(H-hy)*Math.pow(d,1.7);
      ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke();
    }

    /* orbiting sensor blips around the robot */
    const orb=Math.min(W,H);
    for(const p of pts){
      const ang=p.a+t*p.sp;
      const rad=(0.16+p.r*0.20)*orb;
      const x=cx+Math.cos(ang)*rad;
      const y=cy+Math.sin(ang)*rad*0.55;
      const a=0.22+0.26*Math.abs(Math.sin(t*1.5+p.ph));
      ctx.fillStyle='rgba(95,214,223,'+a.toFixed(3)+')';
      ctx.beginPath(); ctx.arc(x,y,1.8,0,7); ctx.fill();
    }

    /* ===== ROBOT (front-view schematic) ===== */
    const glow=0.5+0.5*Math.sin(t*2.2);
    ctx.save();
    ctx.translate(cx,cy);

    /* ===== INDUSTRIAL RETICLE (behind robot) ===== */
    ctx.save();
    ctx.rotate(t*0.22);
    ctx.strokeStyle='rgba(95,214,223,0.16)'; ctx.lineWidth=1; ctx.setLineDash([6,10]);
    ctx.beginPath(); ctx.arc(0,8*s,112*s,0,7); ctx.stroke();
    ctx.setLineDash([]);
    ctx.rotate(-t*0.44);
    ctx.strokeStyle='rgba(155,140,255,0.14)'; ctx.setLineDash([3,7]);
    ctx.beginPath(); ctx.arc(0,8*s,90*s,0,7); ctx.stroke();
    ctx.setLineDash([]);
    ctx.restore();
    /* crosshair */
    ctx.strokeStyle='rgba(95,214,223,0.08)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(-132*s,8*s); ctx.lineTo(132*s,8*s); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(0,-82*s); ctx.lineTo(0,112*s); ctx.stroke();

    /* base platform */
    ctx.fillStyle='rgba(95,214,223,0.10)';
    ctx.beginPath(); ctx.ellipse(0,92*s,60*s,16*s,0,0,7); ctx.fill();
    ctx.strokeStyle='rgba(95,214,223,0.35)'; ctx.lineWidth=1.4;
    ctx.beginPath(); ctx.ellipse(0,92*s,60*s,16*s,0,0,7); ctx.stroke();
    /* turntable ticks (rotating) */
    (function(){
      const N=40, rx=60*s, ry=16*s;
      for(let i=0;i<N;i++){
        const a=t*0.35 + i/N*6.283;
        const px=Math.cos(a)*rx, py=Math.sin(a)*ry;
        const long=(i%4===0);
        const len=(long?5:2.5)*s;
        const k1=(rx+len)/rx, k2=(ry+len)/ry;
        ctx.strokeStyle='rgba(95,214,223,'+(long?0.4:0.18).toFixed(3)+')';
        ctx.lineWidth=long?1.4:1;
        ctx.beginPath(); ctx.moveTo(px,92*s+py); ctx.lineTo(px*k1,92*s+py*k2); ctx.stroke();
      }
    })();

    /* ===== BODY (metallic mech plating) ===== */
    const bg=ctx.createLinearGradient(-34*s,-10*s,34*s,68*s);
    bg.addColorStop(0,'rgba(150,200,235,0.18)');
    bg.addColorStop(0.5,'rgba(120,150,190,0.06)');
    bg.addColorStop(1,'rgba(95,80,150,0.16)');
    ctx.fillStyle=bg;
    ctx.strokeStyle='rgba(155,140,255,0.7)'; ctx.lineWidth=2;
    rr(-34*s,-10*s,68*s,78*s,12*s); ctx.fill(); ctx.stroke();
    /* panel seams */
    ctx.strokeStyle='rgba(95,214,223,0.18)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(-30*s,16*s); ctx.lineTo(30*s,16*s); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(0,-6*s); ctx.lineTo(0,58*s); ctx.stroke();
    /* left cyan / right purple rim light (depth) */
    ctx.strokeStyle='rgba(95,214,223,0.85)'; ctx.lineWidth=2.4;
    ctx.beginPath(); ctx.moveTo(-34*s+2,-8*s); ctx.lineTo(-34*s+2,58*s); ctx.stroke();
    ctx.strokeStyle='rgba(155,140,255,0.8)';
    ctx.beginPath(); ctx.moveTo(34*s-2,-8*s); ctx.lineTo(34*s-2,58*s); ctx.stroke();
    /* chest core + expanding energy rings */
    for(let k=0;k<2;k++){
      const ph=((t*0.6)+k*0.5)%1;
      ctx.strokeStyle='rgba(155,140,255,'+(0.45*(1-ph)).toFixed(3)+')';
      ctx.lineWidth=1.4; ctx.beginPath(); ctx.arc(0,26*s,10*s+ph*24*s,0,7); ctx.stroke();
    }
    const cg=ctx.createRadialGradient(0,26*s,1,0,26*s,10*s);
    cg.addColorStop(0,'rgba(220,210,255,0.95)');
    cg.addColorStop(1,'rgba(155,140,255,'+(0.5+0.4*glow).toFixed(3)+')');
    ctx.fillStyle=cg; ctx.beginPath(); ctx.arc(0,26*s,10*s,0,7); ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,0.6)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.arc(0,26*s,10*s,0,7); ctx.stroke();
    /* chest ventilation grille */
    ctx.strokeStyle='rgba(95,214,223,0.20)'; ctx.lineWidth=1;
    for(let i=0;i<5;i++){ const yy=44*s+i*5*s; ctx.beginPath(); ctx.moveTo(-18*s,yy); ctx.lineTo(18*s,yy); ctx.stroke(); }

    /* arms (mechanical plating + joints + claw hand, gentle sway) */
    const sw=Math.sin(t*1.4)*7*s;
    ctx.lineCap='round'; ctx.lineJoin='round';
    function arm(sx,sy,ex,ey,hx,hy){
      /* limb base (dark metal tube) */
      ctx.strokeStyle='rgba(130,165,205,0.30)'; ctx.lineWidth=9*s;
      ctx.beginPath(); ctx.moveTo(sx,sy); ctx.lineTo(ex,ey); ctx.lineTo(hx,hy); ctx.stroke();
      /* cyan highlight along the limb */
      ctx.strokeStyle='rgba(95,214,223,0.6)'; ctx.lineWidth=1.6;
      ctx.beginPath(); ctx.moveTo(sx,sy); ctx.lineTo(ex,ey); ctx.lineTo(hx,hy); ctx.stroke();
      /* shoulder + elbow joints */
      ctx.fillStyle='rgba(95,214,223,0.55)';
      ctx.beginPath(); ctx.arc(sx,sy,4*s,0,7); ctx.fill();
      ctx.beginPath(); ctx.arc(ex,ey,3.4*s,0,7); ctx.fill();
      /* hand: palm plate + 3 fingers */
      ctx.fillStyle='rgba(130,165,205,0.32)';
      rr(hx-5*s,hy-1*s,10*s,9*s,3*s); ctx.fill();
      ctx.strokeStyle='rgba(95,214,223,0.6)'; ctx.lineWidth=1.4;
      rr(hx-5*s,hy-1*s,10*s,9*s,3*s); ctx.stroke();
      ctx.lineWidth=1.6;
      for(let f=-1;f<=1;f++){ const fx=hx+f*3.4*s; ctx.beginPath(); ctx.moveTo(fx,hy+8*s); ctx.lineTo(fx,hy+13*s+(f===0?0:1.5*s)); ctx.stroke(); }
    }
    arm(-32*s,4*s, -50*s,40*s+sw, -45*s,70*s);
    arm(32*s,4*s, 50*s,40*s-sw, 45*s,70*s);
    ctx.lineCap='butt'; ctx.lineJoin='miter';

    /* neck */
    ctx.strokeStyle='rgba(95,214,223,0.5)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(0,-10*s); ctx.lineTo(0,-22*s); ctx.stroke();

    /* ===== HEAD HOLO-HUD ring (behind head) ===== */
    ctx.save();
    ctx.translate(0,-43*s); ctx.rotate(t*0.5);
    ctx.strokeStyle='rgba(95,214,223,0.20)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.arc(0,0,40*s,0,7); ctx.stroke();
    for(let i=0;i<12;i++){
      const a=i/12*6.283, long=(i%3===0), r1=40*s, r2=(long?34:37)*s;
      ctx.strokeStyle='rgba(95,214,223,'+(long?0.5:0.22).toFixed(3)+')';
      ctx.beginPath(); ctx.moveTo(Math.cos(a)*r1,Math.sin(a)*r1); ctx.lineTo(Math.cos(a)*r2,Math.sin(a)*r2); ctx.stroke();
    }
    const sa=t*1.2, sweep=0.6;
    ctx.strokeStyle='rgba(155,140,255,0.75)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(0,0,40*s,sa,sa+sweep); ctx.stroke();
    ctx.restore();

    /* head */
    const hg=ctx.createLinearGradient(-28*s,-64*s,28*s,-22*s);
    hg.addColorStop(0,'rgba(150,200,235,0.20)');
    hg.addColorStop(1,'rgba(95,80,150,0.15)');
    ctx.fillStyle=hg;
    ctx.strokeStyle='rgba(95,214,223,0.8)'; ctx.lineWidth=2;
    rr(-28*s,-64*s,56*s,42*s,10*s); ctx.fill(); ctx.stroke();
    /* brow seam */
    ctx.strokeStyle='rgba(95,214,223,0.22)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(-22*s,-46*s); ctx.lineTo(22*s,-46*s); ctx.stroke();
    /* head rim light */
    ctx.strokeStyle='rgba(95,214,223,0.85)'; ctx.lineWidth=2.2;
    ctx.beginPath(); ctx.moveTo(-28*s+2,-58*s); ctx.lineTo(-28*s+2,-28*s); ctx.stroke();
    ctx.strokeStyle='rgba(155,140,255,0.8)';
    ctx.beginPath(); ctx.moveTo(28*s-2,-58*s); ctx.lineTo(28*s-2,-28*s); ctx.stroke();
    /* visor */
    ctx.fillStyle='rgba(8,14,22,0.88)';
    rr(-23*s,-56*s,46*s,22*s,6*s); ctx.fill();
    /* eyes (blink + look toward cursor) */
    const blink=(Math.sin(t*1.1)>0.96)?0.15:1;
    const ex=mNX*4*s, ey=mNY*3*s;
    ctx.fillStyle='rgba(95,214,223,'+(0.9*blink).toFixed(3)+')';
    ctx.shadowColor='rgba(95,214,223,0.8)'; ctx.shadowBlur=10*blink;
    rr(-18*s+ex,-50*s+ey,13*s,9*s,3*s); ctx.fill();
    rr(5*s+ex,-50*s+ey,13*s,9*s,3*s); ctx.fill();
    ctx.shadowBlur=0;
    /* antenna */
    ctx.strokeStyle='rgba(95,214,223,0.7)'; ctx.lineWidth=1.6;
    ctx.beginPath(); ctx.moveTo(0,-64*s); ctx.lineTo(0,-78*s); ctx.stroke();
    ctx.fillStyle='rgba(155,140,255,'+(0.5+0.5*glow).toFixed(3)+')';
    ctx.beginPath(); ctx.arc(0,-82*s,3.2*s,0,7); ctx.fill();

    /* scan sweep over chassis */
    const syy=(-64+((t*0.5)%1)*120)*s;
    const sg2=ctx.createLinearGradient(0,syy-9*s,0,syy+9*s);
    sg2.addColorStop(0,'rgba(95,214,223,0)');
    sg2.addColorStop(0.5,'rgba(95,214,223,0.22)');
    sg2.addColorStop(1,'rgba(95,214,223,0)');
    ctx.fillStyle=sg2; ctx.fillRect(-44*s,syy-9*s,88*s,18*s);

    ctx.restore();

    if(elMode) elMode.textContent = (Math.sin(t*0.8)>0)?'REALTIME':'ONLINE';
    requestAnimationFrame(draw);
  }
  requestAnimationFrame(draw);
})();

/* ============ reveal ============ */
const rio=new IntersectionObserver((ents)=>{
  ents.forEach(e=>{ if(e.isIntersecting){e.target.classList.add('in');rio.unobserve(e.target);} });
},{threshold:0.12});
document.querySelectorAll('.reveal').forEach(el=>rio.observe(el));

